# Flask
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=60

# Database
DATABASE_URL=sqlite:///network_copilot.db

# Credential encryption (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=

# Lab / management network
MANAGEMENT_NETWORK=10.10.10.0/24
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30

# Monitoring scheduler
MONITORING_ENABLED=false
MONITORING_INTERVAL_SECONDS=60

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# AI provider. Get a Gemini key at https://aistudio.google.com/apikey
# Cheapest first: gemini-2.5-flash-lite < gemini-2.5-flash < gemini-2.5-pro
# For Anthropic instead: AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5,
# and pip install "network-copilot[anthropic]"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Device credentials used by scripts/seed_lab.py and scripts/smoke_test_lab.py
LAB_SSH_USERNAME=
LAB_SSH_PASSWORD=
