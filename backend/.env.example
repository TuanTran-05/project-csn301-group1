# Flask
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=60

# Database
DATABASE_URL=sqlite:///network_copilot.db

# Credential encryption (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=

# Lab / management network
MANAGEMENT_NETWORK=172.16.3.0/24
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
# Folder where "Đẩy sang PNETLab" creates labs (the export account must be allowed to write there).
PNETLAB_EXPORT_FOLDER=/Courses/CSN301-StudentLab/Group-1
# SSH login the export gives the nodes it starts (through their console),
# and how long it waits for them to boot.
LAB_SSH_USERNAME=g1
LAB_SSH_PASSWORD=group1
PNETLAB_BOOT_TIMEOUT=900

# Monitoring scheduler
MONITORING_ENABLED=false
MONITORING_INTERVAL_SECONDS=60

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# AI provider. Get a Gemini key at https://aistudio.google.com/apikey
# Cheapest first: gemini-2.5-flash-lite < gemini-2.5-flash < gemini-2.5-pro
# For Anthropic instead: AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5,
# and pip install "network-copilot[anthropic]"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# Before each chat message a short call labels it (design / read on a device /
# configure / question) to pick the pipeline; false: keyword rules only.
AI_INTENT_ROUTER=true
# Model for that call; empty uses AI_MODEL. A fast, cheap one is enough
# (e.g. gemini-2.5-flash-lite). Check it with scripts/eval_intent_router.py.
AI_ROUTER_MODEL=
AI_API_KEY=

# Device credentials used by scripts/seed_lab.py and scripts/smoke_test_lab.py
LAB_SSH_USERNAME=
LAB_SSH_PASSWORD=

# Devices polled at the same time by the monitoring job.
# MONITORING_MAX_WORKERS=4

# Server-sent events for the chat page. Each open stream holds a server thread;
# run Gunicorn with --worker-class gthread --threads N, or set this to false.
# REALTIME_ENABLED=true
# REALTIME_MAX_STREAMS=20
# REALTIME_MAX_SECONDS=55
# REALTIME_POLL_SECONDS=2
